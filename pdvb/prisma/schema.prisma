generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { CUSTOMER STAFF ADMIN }
enum OrderStatus { PENDING_CONFIRMATION CONFIRMED PREPARING READY_FOR_PICKUP OUT_FOR_DELIVERY DELIVERED CANCELLED }
enum PaymentMethod { ONLINE COD }
enum PaymentStatus { PENDING AUTHORIZED PAID FAILED REFUND_PENDING PARTIALLY_REFUNDED REFUNDED }
enum NotificationChannel { WHATSAPP EMAIL }
enum NotificationStatus { PENDING SENT DELIVERED READ FAILED DEMO }
enum DiscountType { PERCENT FLAT }
enum PrescriptionStatus { PENDING APPROVED REJECTED }

// All money is stored as integer paise (1 rupee = 100 paise). No floats.

model User {
  id           String    @id @default(cuid())
  name         String
  email        String?   @unique
  phone        String?
  passwordHash String?
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  addresses    Address[]
  orders       Order[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  line1     String
  locality  String
  pincode   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  emoji     String
  tagline   String    @default("")
  sortOrder Int       @default(0)
  products  Product[]
  shops     Shop[]
}

model Shop {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  description    String    @default("")
  imageUrl       String?
  categoryId     String
  opensAt        String    @default("10:00")
  closesAt       String    @default("22:00")
  isActive       Boolean   @default(true)
  deliveryEtaMin Int       @default(40)
  minOrderPaise  Int       @default(0)
  deliveryFeePaise Int?    // overrides the global fee when set
  category       Category  @relation(fields: [categoryId], references: [id])
  products       Product[]
  @@index([categoryId])
}

model Product {
  id                   String           @id @default(cuid())
  slug                 String           @unique
  name                 String
  description          String           @default("")
  imageUrl             String?
  categoryId           String
  shopId               String?
  group                String?          // e.g. "Leafy vegetables", "Dairy products", "Menu: Biryani"
  requiresPrescription Boolean          @default(false)
  isAvailable          Boolean          @default(true)
  isFeatured           Boolean          @default(false)
  popularity           Int              @default(0)
  prepTimeMin          Int?
  archivedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  category             Category         @relation(fields: [categoryId], references: [id])
  shop                 Shop?            @relation(fields: [shopId], references: [id])
  variants             ProductVariant[]
  @@index([categoryId, isAvailable])
  @@index([shopId])
  @@index([name])
}

// Every product has at least one variant (pack size / portion / weight).
// Price and stock live here, so inventory is tracked per sellable unit.
model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  label       String      // "1 kg", "Half", "Tray of 30"
  pricePaise  Int
  mrpPaise    Int?        // original price when discounted
  stockQty    Int         @default(100)
  isAvailable Boolean     @default(true)
  sortOrder   Int         @default(0)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  @@index([productId])
}

model Coupon {
  id               String       @id @default(cuid())
  code             String       @unique
  description      String       @default("")
  type             DiscountType
  value            Int          // percent (1-100) or flat paise
  maxDiscountPaise Int?
  minOrderPaise    Int          @default(0)
  startsAt         DateTime?
  expiresAt        DateTime?
  usageLimit       Int?
  usedCount        Int          @default(0)
  isActive         Boolean      @default(true)
}

model Order {
  id               String        @id @default(cuid())
  number           String        @unique
  idempotencyKey   String        @unique
  accessToken      String        @unique  // unguessable token in confirmation URL
  userId           String?
  customerName     String
  phone            String
  email            String?
  addressLine      String
  locality         String
  pincode          String
  instructions     String?
  status           OrderStatus   @default(PENDING_CONFIRMATION)
  paymentMethod    PaymentMethod
  subtotalPaise    Int
  discountPaise    Int
  deliveryFeePaise Int
  taxPaise         Int
  totalPaise       Int
  couponCode       String?
  shopId           String?
  codCollectedAt   DateTime?
  codCollectedById String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User?         @relation(fields: [userId], references: [id])
  items            OrderItem[]
  payment          Payment?
  history          OrderStatusHistory[]
  notifications    NotificationJob[]
  refunds          Refund[]
  prescriptions    PrescriptionUpload[]
  @@index([createdAt])
  @@index([status])
  @@index([phone])
}

// Price snapshot: later price changes never alter historical orders.
model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  variantId      String
  productId      String
  name           String
  variantLabel   String
  categorySlug   String
  unitPricePaise Int
  qty            Int
  lineTotalPaise Int
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amountPaise       Int
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id])
  refunds           Refund[]
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  providerEventId String    @unique   // Razorpay x-razorpay-event-id: makes retries idempotent
  type            String
  payload         Json
  processedAt     DateTime?
  error           String?
  createdAt       DateTime  @default(now())
}

model Refund {
  id               String   @id @default(cuid())
  orderId          String
  paymentId        String
  amountPaise      Int
  status           String   @default("PENDING") // PENDING | PROCESSED | FAILED
  providerRefundId String?  @unique
  reason           String
  requestedById    String
  createdAt        DateTime @default(now())
  order            Order    @relation(fields: [orderId], references: [id])
  payment          Payment  @relation(fields: [paymentId], references: [id])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  actorId    String?
  actorLabel String       // "customer", "system", or admin name
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
}

model NotificationJob {
  id                String              @id @default(cuid())
  orderId           String
  channel           NotificationChannel
  kind              String              // ORDER_PAID | ORDER_COD
  dedupeKey         String              @unique // "<orderId>:<kind>:<channel>" prevents duplicates
  status            NotificationStatus  @default(PENDING)
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime            @default(now())
  lastError         String?
  providerMessageId String?             @unique
  messagePreview    String?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  logs              NotificationLog[]
  @@index([status, nextAttemptAt])
}

model NotificationLog {
  id        String          @id @default(cuid())
  jobId     String
  status    NotificationStatus
  detail    String?
  createdAt DateTime        @default(now())
  job       NotificationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@index([jobId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model DeliveryZone {
  id               String  @id @default(cuid())
  pincode          String  @unique
  label            String?
  isActive         Boolean @default(true)
  deliveryFeePaise Int?
  codAllowed       Boolean @default(true)
}

model PrescriptionUpload {
  id           String             @id @default(cuid())
  orderId      String?
  fileKey      String             // private object-storage key; never a public URL
  status       PrescriptionStatus @default(PENDING)
  reviewedById String?
  createdAt    DateTime           @default(now())
  order        Order?             @relation(fields: [orderId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
}
